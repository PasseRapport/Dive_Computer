/*
 * Devicetree overlay - Dive Computer V2 (nRF52840 QIAA-F, custom board)
 *
 * Carries the GPIO pin assignments of the design so they are visible
 * and editable in the Devicetree Visual Editor (Pin Overview).
 * The buses, their pinctrl and the sensor/screen nodes are defined in
 * the board files (boards/nordic/dc_v2_2/); keep the pin numbers here
 * in sync with the KiCad schematic.
 *
 * Pin map (QIAA pad in brackets):
 *   P0.02 [A12] INT_ACC1   P0.03 [B13] INT_ENC    P0.04 [J1] SCREEN_SCL
 *   P0.05 [K2] SCREEN_SDI  P0.09 [L24] QI_EN     P0.10 [J24] ~CHG
 *   P0.11 [T2] SCREEN_CS   P0.15 [AD10] SCL      P0.17 [AD12] SDA
 *   P0.18 [AC13] nRESET   P0.20 [AD16] BL_PWM_MCU
 *   P0.28 [B11] 1.2+1.8V_EN P0.29 [A10] 3.1V_EN P0.30 [B9] INT_LIGHT
 *   P0.31 [A8] SYNC (TE)  P1.09 [R1] SCREEN_RST
 * (SPI/I2C bus pins are in dc_v2_2_nrf52840-pinctrl.dtsi.)
 *
 * SPDX-License-Identifier: Apache-2.0
 */

/ {
	/* Rail control outputs. All LDO enables are active high
	 * (TPS7A02 family, internal pull-down: floating = off).
	 * P0.28 enables both 1.2 V (MIPI LP-11) and peripheral 1.8 V:
	 * sensors, interrupt/I2C pull-ups and panel VDDI/DCX. This is not
	 * independent sensor/display control. Rail off removes sensor wake
	 * and pressure acquisition. 3.1 V (VCI) stays separate.
	 */
	gpio-leds {
		compatible = "gpio-leds";

		rail_1v2_1v8_en {
			gpios = <&gpio0 28 GPIO_ACTIVE_HIGH>;
		};

		rail_3v1_en {
			gpios = <&gpio0 29 GPIO_ACTIVE_HIGH>;
		};

		qi_en {
			/* Historical QI_EN net reaches BQ51051B EN2 (AD=GND):
			 * adapter-source priority, NOT global wireless-charge off. */
			gpios = <&gpio0 9 0>;
		};

		bl_pwm_mcu {
			gpios = <&gpio0 20 GPIO_ACTIVE_HIGH>;
		};
	};

	zephyr,user {
		/* BQ51051B ~CHG is open-drain, active low. Future code must
		 * configure GPIO_INPUT with these DT flags. This passive policy
		 * does not initialize GPIO; idle is undefined until then. The
		 * internal pull-up is toward always-powered MCU VDD, never BAT+
		 * or the switched peripheral rail. No resistor is added here. */
		chg_n-gpios = <&gpio0 10 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		chg_n-input;
		chg_n-pullup-domain = "mcu-vdd";
	};
};

&spi1 {
	cs-gpios = <&gpio0 11 GPIO_ACTIVE_LOW>;
};

/* Screen control pins: reset (active low) and TE frame-sync input. */
&lcd {
	reset-gpios = <&gpio1 9 GPIO_ACTIVE_LOW>;
	te-gpios = <&gpio0 31 GPIO_ACTIVE_HIGH>;
};

/* Single ownership: sensor nodes own their MCU interrupt inputs; no parallel
 * gpio-keys consumer. These low-frequency pins require <=10 kHz event rates.
 * GPIO/sense declarations do not configure the sensors or prove wake-up. */
&acc {
	/* INT_ACC1: intended sensor push-pull, active high. */
	int1-gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
	status = "okay";
};

&enc {
	/* INT_ENC: open-drain, external 10k to switched peripheral 1.8 V.
	 * Event/change use; do not export every 20 kHz conversion. */
	int-gpios = <&gpio0 3 GPIO_ACTIVE_LOW>;
};

&light {
	/* INT_LIGHT: open-drain, external 10k to switched peripheral 1.8 V. */
	int-gpios = <&gpio0 30 GPIO_ACTIVE_LOW>;
};
