/*
 * Dive Computer V2 rev 2, nRF52840-QIAA-F.
 * Approved Pin Studio plan, 2026-11-10: boards/nordic/dc_v2_2/pin-plan.json.
 * SPI0: SCK P0.04, MOSI P0.26. I2C1: SCL P0.27, SDA P0.05.
 * Passive routing/polarity/bias declarations, not a runtime power sequence.
 * SPDX-License-Identifier: Apache-2.0
 */
/ {
	/* Three independent active-high external regulator enables.
	 * Switched peripheral 1.8 V is distinct from always-powered MCU VDD. */
	gpio-leds {
		compatible = "gpio-leds";
		rail_1v2_en {
			gpios = <&gpio0 3 GPIO_PULL_DOWN>;
		};
		rail_1v8_en {
			gpios = <&gpio1 14 GPIO_PULL_DOWN>;
		};
		rail_3v1_en {
			gpios = <&gpio0 28 GPIO_PULL_DOWN>;
		};
		qi_en {
			/* BQ51051B EN2 adapter priority, not global Qi off. */
			gpios = <&gpio1 1 GPIO_ACTIVE_HIGH>;
		};
	};
	zephyr,user {
		/* Open-drain charger status; external pull-up to MCU VDD confirmed.
		 * Input only, with no MCU pull or output-driver flags. */
		chg_n-gpios = <&gpio1 2 GPIO_ACTIVE_LOW>;
		chg_n-input;
		chg_n-pullup-domain = "external-mcu-vdd";
	};
};

&spi0 {
	cs-gpios = <&gpio0 8 (GPIO_ACTIVE_LOW | GPIO_PULL_DOWN)>;
};

&lcd {
	reset-gpios = <&gpio0 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
	te-gpios = <&gpio1 9 GPIO_ACTIVE_HIGH>;
};

/* Single owner per interrupt, no duplicate gpio-keys. Intended ACC/MAG
 * active-high configuration follows SDK bindings; these flags do not set
 * sensor registers. Hall/light/haptic IRQ are active low. */
&acc {
	int1-gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
	int2-gpios = <&gpio0 29 GPIO_ACTIVE_HIGH>;
	status = "okay";
};

&mag {
	irq-gpios = <&gpio1 15 GPIO_ACTIVE_HIGH>;
};

&enc {
	int-gpios = <&gpio0 30 GPIO_ACTIVE_LOW>;
};

&light {
	int-gpios = <&gpio1 13 GPIO_ACTIVE_LOW>;
};

&haptic {
	/* TRIG/INTZ in interrupt mode needs an external pull-up.
	 * No haptic register setup/driver is implemented by this declaration. */
	int-gpios = <&gpio0 31 GPIO_ACTIVE_LOW>;
};

/* BL_PWM_MCU P0.12 has only the optional PWM0 owner, disabled normally.
 * Manual fallback: R7 fitted/R8 removed. Normal panel PWM: R8 fitted/R7 DNP. */
