/*
 * Dive Computer V2 rev 2 - nRF52840-QIAA pin control.
 * Existing GPIO assignments are retained; QIAA-F is the procurement variant.
 * QIAA standard-drive/low-frequency recommendation (<=10 kHz): P0.02,
 * P0.03, P0.09, P0.10, P0.28-P0.31. P0.31 TE is documented at 63.1 Hz,
 * 560 us high; this does not qualify a future line-rate TE mode.
 * SPI P0.04/P0.05 and I2C P0.15/P0.17 have no such restriction.
 * P0.00/P0.01 remain XL1/XL2; P0.18 remains nRESET.
 * SPDX-License-Identifier: Apache-2.0
 */

&pinctrl {
	/* Shared sensor bus: LIS2MDL (0x1E), LIS2DUX12 (0x19), VEML6035,
	 * TMAG3001 (ADDR=GND), MS5837-30BA (0x76), DRV2624 (0x5A).
	 * External 4.7k pull-ups to the always-on 1.8 V rail. */
	i2c0_default: i2c0_default {
		group1 {
			psels = <NRF_PSEL(TWIM_SCL, 0, 15)>,
				<NRF_PSEL(TWIM_SDA, 0, 17)>;
		};
	};

	i2c0_sleep: i2c0_sleep {
		group1 {
			psels = <NRF_PSEL(TWIM_SCL, 0, 15)>,
				<NRF_PSEL(TWIM_SDA, 0, 17)>;
			/* High-Z in sleep: the external pull-ups to the
			 * always-on 1.8 V rail keep the bus defined while
			 * the sensors stay powered for wake-up events. */
			low-power-enable;
		};
	};

	/* JDI three-wire nine-bit framing needs a future transport over the
	 * installed eight-bit-word SPIM driver: packing, exact clocks and CS
	 * continuity are not implemented here. No MISO/read path is routed.
	 * 8 MHz remains the confirmed ceiling with unresolved setup margin:
	 * 62.5 - 59 = 3.5 ns versus 20 ns register / 5 ns GRAM requirement.
	 * validation/spi4mhz.overlay selects the audit's recommended 4 MHz
	 * and high drive, leaving 66 ns before board skew. DC/10 ns edges
	 * still require physical qualification. */
	spi1_default: spi1_default {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 0, 4)>,
				<NRF_PSEL(SPIM_MOSI, 0, 5)>;
			nordic,drive-mode = <NRF_DRIVE_S0S1>;
		};
	};

	spi1_sleep: spi1_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK, 0, 4)>,
				<NRF_PSEL(SPIM_MOSI, 0, 5)>;
			/* Input/disconnected buffer plus weak pull-down: not a driven
			 * low or an implemented shutdown sequence. Powered mode-0
			 * idle and unpowered GND requirements are distinct. Runtime
			 * sequencing must establish suitable levels before rail-off
			 * and cover CS/reset/TE too; pinctrl alone proves none of it. */
			low-power-enable;
			bias-pull-down;
		};
	};

	/* PWM MCU de secours: P0.20/AD16, no GPIO output alias.
	 * The controller stays disabled until the explicit fallback overlay. */
	pwm0_default: pwm0_default {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 0, 20)>;
			nordic,drive-mode = <NRF_DRIVE_S0S1>;
		};
	};

	pwm0_sleep: pwm0_sleep {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 0, 20)>;
			low-power-enable;
			bias-pull-down;
		};
	};
};
