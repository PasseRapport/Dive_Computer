/*
 * Dive Computer V2 rev 2 - nRF52840-QIAA; procurement variant QIAA-F.
 * Battery feeds VDDH. MCU VDD is distinct from the switched external 1.8 V rail.
 * Both internal DC/DC stages require their Nordic reference LC networks.
 * No image/startup code here writes REGOUT0; inspect the actual device UICR
 * before any later hardware programming. See README-target.txt.
 * SPDX-License-Identifier: Apache-2.0
 */

/dts-v1/;
#include <nordic/nrf52840_qiaa.dtsi>
#include "dc_v2_2_nrf52840-pinctrl.dtsi"

/ {
	model = "Dive Computer V2 rev 2";
	compatible = "dive,dc-v2-2";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,code-partition = &slot0_partition;
		/* No UART is routed on this board;
		 * use SEGGER RTT over SWD for console output. */
	};

	/* Inspectable voltage policy, not proof of a preprogrammed UICR value.
	 * VOUT=0 selects 1.8 V; erased/default VOUT=7 also gives 1.8 V.
	 * Existing devices with another value require separate qualification. */
	zephyr,user {
		mcu-regout0-microvolt = <1800000>;
		mcu-regout0-uicr-vout = <0>;
	};

	/* GPIO pin assignments (gpio-leds/gpio-keys, sensor and screen
	 * control pins, SPI chip select) live in app.overlay so they are
	 * visible and editable in the Devicetree Visual Editor. */
};

/* GPIO ports and GPIOTE are disabled by default in the SoC dtsi;
 * enable them explicitly like the Nordic reference boards do. */
&gpiote {
	status = "okay";
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

/* P0.18/nRESET is wired to the debug connector: configure it as
 * hardware reset so a locked/sleeping device can always be
 * re-attached (same effect as nrfjprog --pinresetenable). */
&uicr {
	gpio-as-nreset;
	nfct-pins-as-gpios;
};

/* Supported SDK regulator selection; do not use deprecated DCDC Kconfig. */
&reg0 {
	status = "okay";
};

&reg1 {
	regulator-initial-mode = <NRF5X_REG_MODE_DCDC>;
};

&i2c0 {
	status = "okay";
	pinctrl-0 = <&i2c0_default>;
	pinctrl-1 = <&i2c0_sleep>;
	pinctrl-names = "default", "sleep";
	clock-frequency = <400000>;

	/* Magnetometer, I2C mode (CS pin tied high), fixed address.
	 * INT/DRDY not routed to the MCU: polled. */
	lis2mdl@1e {
		compatible = "st,lis2mdl";
		reg = <0x1e>;
	};

	/* Accelerometer, I2C mode (CS high), SA0 high. INT1 routed
	 * (wake-on-motion, assigned in app.overlay); INT2 not routed
	 * per pin budget decision. */
	acc: lis2dux12@19 {
		compatible = "st,lis2dux12";
		reg = <0x19>;
	};

	/* Pressure sensor, fixed address. */
	ms5837: ms5837@76 {
		compatible = "meas,ms5837-30ba";
		reg = <0x76>;
	};

	/* 3D Hall sensor for the rotary encoder, ADDR pin to GND. */
	enc: tmag3001@34 {
		compatible = "ti,tmag3001";
		reg = <0x34>;
	};

	/* Ambient light sensor (out-of-tree driver, fixed address). */
	light: veml6035@10 {
		compatible = "vishay,veml6035";
		reg = <0x10>;
	};

	/* Haptic driver, LRA 250 Hz (out-of-tree driver, fixed address). */
	drv2624@5a {
		compatible = "ti,drv2624";
		reg = <0x5a>;
	};
};

&spi1 {
	status = "okay";
	pinctrl-0 = <&spi1_default>;
	pinctrl-1 = <&spi1_sleep>;
	pinctrl-names = "default", "sleep";

	/* JDI LPM013M091A, 320x300 RGB111, three-wire nine-bit protocol
	 * (IM0=GND, DCX=VDDI). No panel transport/driver is implemented.
	 * Absent spi-cpol/spi-cpha select mode 0 (rising-edge sampling).
	 * 8 MHz is the confirmed ceiling, not qualified operating speed.
	 * Chip select/reset/TE live in app.overlay; no MISO/read path. */
	lcd: lpm013m091a@0 {
		compatible = "jdi,lpm013m091a";
		reg = <0>;
		spi-max-frequency = <8000000>;
		width = <320>;
		height = <300>;
	};
};

/* PWM écran remains normal: R8 fitted, R7 DNP. P0.20 has no active
 * owner until explicit fallback selection (R7 fitted, R8 DNP). */
&pwm0 {
	status = "disabled";
	pinctrl-0 = <&pwm0_default>;
	pinctrl-1 = <&pwm0_sleep>;
	pinctrl-names = "default", "sleep";
};

/* Derived layout: 48 + 476 + 476 + 24 KiB; reservations only. */
&flash0 {
	partitions {
		ranges;
		#address-cells = <1>;
		#size-cells = <1>;

		boot_partition: partition@0 {
			compatible = "zephyr,mapped-partition";
			label = "mcuboot";
			reg = <0x00000000 0xc000>;
		};

		slot0_partition: partition@c000 {
			compatible = "zephyr,mapped-partition";
			label = "image-0";
			reg = <0x0000c000 0x77000>;
		};

		slot1_partition: partition@83000 {
			compatible = "zephyr,mapped-partition";
			label = "image-1";
			reg = <0x00083000 0x77000>;
		};

		storage_partition: partition@fa000 {
			compatible = "zephyr,mapped-partition";
			label = "storage";
			reg = <0x000fa000 0x00006000>;
		};
	};
};
