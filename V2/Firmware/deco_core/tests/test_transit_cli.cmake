set(input "fixed 1 2 2 0.7 1 0 0.740467 0.740467 0.740467 0.740467 0.740467 0.740467 0.740467 0.740467 0.740467 0.740467 0.740467 0.740467 0.740467 0.740467 0.740467 0.740467\n")
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/transit-input.txt" "${input}")
execute_process(COMMAND "${CLI}" INPUT_FILE "${CMAKE_CURRENT_BINARY_DIR}/transit-input.txt" OUTPUT_VARIABLE output RESULT_VARIABLE code)
if(NOT code EQUAL 0 OR NOT output MATCHES "\"destination_valid\":true")
