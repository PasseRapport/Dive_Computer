foreach(bad "-1" "+1" "1.2" "18446744073709551616")
  string(REPLACE "0.7 1 0" "0.7 ${bad} 0" invalid "${input}")
  file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/transit-input.txt" "${invalid}")
  execute_process(COMMAND "${CLI}" INPUT_FILE "${CMAKE_CURRENT_BINARY_DIR}/transit-input.txt" OUTPUT_QUIET RESULT_VARIABLE code)
  if(NOT code EQUAL 2)
    message(FATAL_ERROR "Transit CLI accepted invalid allowance ${bad}")
  endif()
endforeach()
