# Focused host adapter checks; invalid tokens must produce no segment output.
set(input "${CMAKE_CURRENT_BINARY_DIR}/tissues-cli-duration-input.txt")
foreach(token IN ITEMS "-1" "+1" "18446744073709551616" "0" "1x" "1.0"
        "99999999999999999999999999999999" "" "000000000000000000001")
    file(WRITE "${input}" "1.01325 2.0 ${token}\n")
    execute_process(COMMAND "${CLI}" 1.01325 INPUT_FILE "${input}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output)
    if(NOT result EQUAL 2)
        message(FATAL_ERROR "Invalid duration '${token}' returned ${result}")
    endif()
    string(REGEX MATCHALL "\n" rows "${output}")
    list(LENGTH rows count)
    if(NOT count EQUAL 2)
        message(FATAL_ERROR "Invalid duration '${token}' emitted a segment result")
    endif()
endforeach()
foreach(token IN ITEMS "1" "18446744073709551615")
    file(WRITE "${input}" "1.01325 2.0 ${token}\n")
    execute_process(COMMAND "${CLI}" 1.01325 INPUT_FILE "${input}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Valid duration '${token}' returned ${result}")
    endif()
    string(REGEX MATCHALL "\n" rows "${output}")
    list(LENGTH rows count)
    if(NOT count EQUAL 3)
        message(FATAL_ERROR "Valid duration '${token}' did not emit a segment result")
    endif()
endforeach()
file(REMOVE "${input}")
