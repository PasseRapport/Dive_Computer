set(tissues "0.740467 0.740467 0.740467 0.740467 0.740467 0.740467 0.740467 0.740467 0.740467 0.740467 0.740467 0.740467 0.740467 0.740467 0.740467 0.740467")
set(input "1 1 1000 none 0 20 9000 0 ${tissues}\n")
set(input_path "${CMAKE_CURRENT_BINARY_DIR}/anchor-input.txt")
file(WRITE "${input_path}" "${input}")
execute_process(COMMAND "${CLI}" INPUT_FILE "${input_path}" OUTPUT_VARIABLE output RESULT_VARIABLE code)
if(NOT code EQUAL 0 OR NOT output MATCHES "\"candidate_valid\":true" OR NOT output MATCHES "\"status\":0")
    message(FATAL_ERROR "Anchor CLI PASS contract failed: ${output}")
endif()
foreach(bad "-1" "+1" "1.2" "18446744073709551616")
    foreach(field "1000" "none 0" "20" "9000")
        if(field STREQUAL "none 0")
            string(REPLACE "none 0" "none ${bad}" invalid "${input}")
        else()
            string(REPLACE "${field}" "${bad}" invalid "${input}")
        endif()
        file(WRITE "${input_path}" "${invalid}")
        execute_process(COMMAND "${CLI}" INPUT_FILE "${input_path}" OUTPUT_QUIET RESULT_VARIABLE code)
        if(NOT code EQUAL 2)
            message(FATAL_ERROR "Anchor CLI accepted invalid ${field}: ${bad}")
        endif()
    endforeach()
endforeach()
foreach(invalid "1 1 1000 none 0 20 9000 0 ${tissues} extra\n" "1 1 1000 none 0 20 9000 0\n")
    file(WRITE "${input_path}" "${invalid}")
    execute_process(COMMAND "${CLI}" INPUT_FILE "${input_path}" OUTPUT_QUIET RESULT_VARIABLE code)
    if(NOT code EQUAL 2)
        message(FATAL_ERROR "Anchor CLI accepted wrong token count")
    endif()
endforeach()
